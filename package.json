{
  "name": "nexuslearn",
  "version": "1.0.0",
  "description": "Collaborative peer learning platform with live AI-assisted sessions",
  "main": "server/dist/index.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "install-all": "npm install && cd server && npm install && cd ../client && npm install",
    "start": "npm --prefix server start",
    "migrate:database": "npm --prefix server run migrate:database",
    "setup": "node setup.js"
  },
  "keywords": [
    "nexuslearn",
    "exchange",
    "learning",
    "community"
  ],
  "author": "NexusLearn Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0"
  }
}
